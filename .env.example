# Порт Node. Мясное приложение, скорее всего, уже на 3000 — берём другой.
PORT=3010
# Папка с базой, фото и секретом. На VPS — постоянная папка вне репозитория.
DATA_DIR=/var/lib/teamcars
# Первый администратор (создаётся только при пустой базе).
ADMIN_NAME=Богдан Анатолійович
ADMIN_PIN=0000
# 1 — заполнить пустую базу демо-данными (только для пробы, не на проде).
SEED_DEMO=0
